# Enter your own credentials locally. Never share a populated .env.
HF_ACCESS_TOKEN=
# HF_TOKEN is also accepted; HF_ACCESS_TOKEN takes precedence.
HF_DEPTH_SPACE=depth-anything/Video-Depth-Anything
HF_DEPTH_API_NAME=/infer_video_depth
# This public SAM demo returns overlays, NOT raw masks. See docs/MODELS.md.
HF_SAM_SPACE=merve/SAM3-video-segmentation
HF_SAM_API_NAME=
HF_SAM_FALLBACK_SPACE=
HF_SAM_FALLBACK_API_NAME=

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
AUDIO_DISGUISE_MODE=pitch_shift
# original copies the complete original audio packets without re-encoding.
# elevenlabs_sts explicitly opts into converted voice + estimated residual mix.
FINAL_AUDIO_SOURCE=original

OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o

# Official OpenArt CLI with its own OAuth login; no OpenArt API key is required.
# Connector sign-in and this local CLI sign-in are separate sessions.
OPENART_CLI_BIN=openart
OPENART_DRAFT_MODEL=byte-plus-seedance-2-5-draft
OPENART_DRAFT_RESOLUTION=480p
# Existing DREAMINA_* settings are used only to collect older Dreamina jobs.
# Legacy Replicate/Enhancor/host/webhook settings are ignored by new jobs.
